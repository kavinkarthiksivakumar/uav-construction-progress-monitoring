# Flask Server Configuration
SECRET_KEY=your_secret_key_here
DEBUG=true
HOST=0.0.0.0
PORT=5000
MAX_CONTENT_LENGTH=524288000
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_BATCH=200

# Dataset Locations
# Use relative paths (from project root) or absolute paths.
# Example relative paths (datasets stored under datasets/ in the project):
LEVIR_CD_PATH=datasets/levir/LEVIR-CD+/LEVIR-CD+
SYSU_CD_PATH=datasets/sysu
ROBOFLOW_PATH=datasets/roboflow

# Example absolute paths (if datasets are stored elsewhere):
# LEVIR_CD_PATH=/path/to/LEVIR-CD+
# SYSU_CD_PATH=/path/to/SYSU-CD
# ROBOFLOW_PATH=/path/to/roboflow-construction-safety

# Optional: Path to trained YOLOv8 model weights (.pt file)
# YOLO_MODEL_PATH=models/yolov8_construction.pt

# Optional: Path to trained change detection model weights (.onnx/.pth)
# CHANGE_DETECTION_MODEL_PATH=models/change_detector.onnx
